APP_NAME="Link Shortener"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Click tracking method for high-traffic scenarios
# Options: queue (default), redis, none
# - queue: Uses Laravel queue (based on QUEUE_CONNECTION)
# - redis: Direct Redis storage with batch processing
# - none: Only increment count, skip detailed tracking
CLICK_TRACKING_METHOD=queue

# Redis batch processing settings (for CLICK_TRACKING_METHOD=redis)
# Batch size - how many clicks to process at once when triggered
REDIS_BATCH_SIZE=500

# Trigger threshold - start processing when this many clicks are pending
# Lower = more frequent processing, Higher = less database load
REDIS_TRIGGER_THRESHOLD=100

CACHE_STORE=file
CACHE_DATABASE_CONNECTION=null
CACHE_DATABASE_TABLE=cache
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# MaxMind GeoLite2 License Key (get free key at https://www.maxmind.com/en/geolite2/signup)
MAXMIND_LICENSE_KEY=

# Homepage behavior configuration
# Redirect to admin panel instead of showing landing page
HOMEPAGE_REDIRECT_TO_ADMIN=false

# Custom redirect URL for homepage (takes precedence over redirect_to_admin)
# HOMEPAGE_REDIRECT_URL=https://example.com

# Custom view to show on homepage (default: welcome)
# HOMEPAGE_VIEW=welcome

# 404 Not Found behavior configuration
# URL to redirect to instead of showing 404 page
# NOT_FOUND_REDIRECT_URL=https://example.com/404

# Whether to track 404 attempts for analytics
NOT_FOUND_TRACK_ATTEMPTS=true

# Custom 404 view template
# NOT_FOUND_VIEW=errors.404

# Mobile app deep-link handoff
APP_HANDOFF_UNIVERSAL_LINK_HOST=app.ufarmer.uz
APP_HANDOFF_SCHEME=ufarmer
APP_HANDOFF_ANDROID_PACKAGE=uz.ufarmer.app
